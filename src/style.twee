:: StoryStylesheet [stylesheet]
config.style.dark.page.font

html {
    background: #111318;
}

body {
    background: #111318;
    color: #e8e8ea;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Roboto, Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.6;
}

main {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 22px 80px;
}

/* Main headings */
h1 {
    font-size: 26px;
    margin: 0 0 24px;
    color: #ffffff;
}

h2 {
    font-size: 15px;
    font-weight: 600;
    color: #8d929c;
    margin: 30px 0 22px;
    letter-spacing: .02em;
}

/* Speaker names */
strong {
    color: #ffffff;
    font-weight: 650;
}

/* Normal prose / narration */
p {
    margin: 0 0 16px;
}

/* Choices */
a {
    color: #d9dcff;
    text-decoration: none;
}

/* Chapbook choice links */
main a {
    display: block;
    padding: 13px 16px;
    margin: 9px 0;
    background: #1c1f27;
    border: 1px solid #30343e;
    border-radius: 10px;
}

main a:hover {
    background: #272b35;
    border-color: #555b69;
}

/* Separators */
hr {
    border: 0;
    border-top: 1px solid #292d35;
    margin: 32px 0;
}

/* Images sent through chat */
img {
    max-width: 100%;
    border-radius: 12px;
    margin: 14px 0;
}